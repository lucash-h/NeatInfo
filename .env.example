# Copy to .env (gitignored) for scripts/seed-articles.mjs.
# This is the PRODUCTION passphrase -- the one you type into the app's gate --
# which is NOT the same value as PASSPHRASE in .dev.vars, and must not be.
NEATINFO_PASSPHRASE=

# Optional: the instance to seed, so --base can be left off.
NEATINFO_BASE=https://neatinfo.raaaaaaaaaaaa.workers.dev
